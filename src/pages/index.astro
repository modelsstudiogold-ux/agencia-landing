---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Benefits from "../components/sections/Benefits.astro";
import Process from "../components/sections/Process.astro";
import FAQ from "../components/sections/FAQ.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
import Footer from "../components/sections/Footer.astro";
import LeadModal from "../components/react/LeadModal";
import StickyWhatsApp from "../components/react/StickyWhatsApp";
import { buildSeo } from "../lib/seo";

const seo = buildSeo({
  title: "Aplica hoy | Gold Models",
  description:
    "Landing page oficial para aplicar a oportunidades remotas. Proceso guiado, pagos transparentes y soporte real. Solo para mayores de 18 años.",
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined,
});
---

<BaseLayout {...seo}>
  <main class="page">
    <Hero />
    <Benefits />
    <Process />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <LeadModal client:load />
  <StickyWhatsApp client:load />
</BaseLayout>

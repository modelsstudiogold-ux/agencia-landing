---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/sections/Footer.astro";
import Button from "../components/ui/Button.astro";
import Container from "../components/ui/Container.astro";
import StickyWhatsApp from "../components/ui/StickyWhatsApp.astro";
import { buildSeo } from "../lib/seo";
import { AGENCY_NAME, SOCIAL_LINKS, WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../lib/constants";

const LANDING_VARIANT = "landing_confianza";
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}?text=${encodeURIComponent(
  WHATSAPP_MESSAGE,
)}`;

const seo = buildSeo({
  title: "Gold Models Studio | Acompa\u00f1amiento profesional en Bogot\u00e1",
  description:
    "Conoce un estudio profesional con orientaci\u00f3n, privacidad y acompa\u00f1amiento para tomar una decisi\u00f3n informada. Resuelve tus dudas por WhatsApp.",
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined,
});

const originUrl = Astro.site?.origin ?? "https://goldmodelsstudio.com";
const siteUrl = seo.url ?? `${originUrl}/trabaja-como-modelo-webcam`;
const popupVideoUrl = "/videos/testimonio_3.mp4";

const trustItems = [
  {
    title: "Acompa\u00f1amiento personalizado",
    text: "Te orientamos con informaci\u00f3n clara para que entiendas cada etapa antes de avanzar.",
  },
  {
    title: "Capacitaci\u00f3n inicial",
    text: "Recibes una introducci\u00f3n al proceso, buenas pr\u00e1cticas y expectativas reales desde el inicio.",
  },
  {
    title: "Ambiente privado",
    text: "Cuidamos la discreci\u00f3n, el trato profesional y el manejo responsable de tu informaci\u00f3n.",
  },
  {
    title: "Comunicaci\u00f3n clara",
    text: "Resolvemos tus dudas por canales oficiales y evitamos promesas poco realistas.",
  },
  {
    title: "Soporte durante el proceso",
    text: "Tienes acompa\u00f1amiento humano para tomar decisiones con tranquilidad.",
  },
];

const processSteps = [
  "Nos escribes por WhatsApp",
  "Resolvemos tus dudas",
  "Te explicamos el proceso",
  "Recibes orientaci\u00f3n inicial",
  "Decides si quieres continuar",
];

const benefits = [
  "Horarios flexibles",
  "Capacitaci\u00f3n",
  "Acompa\u00f1amiento",
  "Orientaci\u00f3n personalizada",
  "Ambiente profesional",
  "Crecimiento seg\u00fan dedicaci\u00f3n y desempe\u00f1o",
];

const faqItems = [
  {
    question: "\u00bfNecesito experiencia previa?",
    answer:
      "No. Puedes escribirnos para conocer el proceso y recibir orientaci\u00f3n inicial antes de tomar una decisi\u00f3n.",
  },
  {
    question: "\u00bfMe capacitan?",
    answer:
      "S\u00ed. Te explicamos las bases del proceso, las buenas pr\u00e1cticas y la forma de trabajar de manera profesional.",
  },
  {
    question: "\u00bfPuedo resolver dudas antes de iniciar?",
    answer:
      "S\u00ed. El primer paso es conversar por WhatsApp para responder tus preguntas con claridad.",
  },
  {
    question: "\u00bfMi informaci\u00f3n es privada?",
    answer:
      "Tratamos tu informaci\u00f3n con discreci\u00f3n y solo usamos los datos necesarios para orientarte sobre el proceso.",
  },
  {
    question: "\u00bfC\u00f3mo funciona el proceso?",
    answer:
      "Nos escribes, resolvemos tus dudas, te explicamos los pasos y recibes orientaci\u00f3n inicial para decidir si quieres continuar.",
  },
  {
    question: "\u00bfPuedo hablar con alguien antes de tomar una decisi\u00f3n?",
    answer:
      "S\u00ed. Puedes hablar con un asesor por WhatsApp y avanzar solo cuando tengas claridad.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: AGENCY_NAME,
      url: siteUrl,
      logo: `${originUrl}/images/icons/gold-models-dorado.png`,
      sameAs: [SOCIAL_LINKS.instagram, SOCIAL_LINKS.tiktok],
      contactPoint: {
        "@type": "ContactPoint",
        telephone: WHATSAPP_NUMBER,
        contactType: "customer service",
        areaServed: "CO",
        availableLanguage: "es",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout {...seo} schema={schema} landingVariant={LANDING_VARIANT}>
  <main class="page confianza-page" id="contenido">
    <section class="video-popup" id="video-popup" role="dialog" aria-modal="true" aria-labelledby="video-popup-title" aria-describedby="video-popup-copy">
      <div class="video-popup__surface" role="document">
        <button type="button" class="video-popup__close" id="video-popup-close" aria-label="Cerrar ventana">&times;</button>
        <p class="eyebrow">Testimonio real</p>
        <h2 id="video-popup-title">“Llegu&eacute; sin experiencia y aprend&iacute; desde cero.”</h2>
        <p class="video-popup__copy" id="video-popup-copy">
          Si llegaste buscando trabajo webcam en bogot&aacute;, aqu&iacute; puedes ver una historia real antes de escribirnos.
        </p>
        <video class="video-popup__player" id="video-popup-player" controls preload="metadata" playsinline>
          <source src={popupVideoUrl} type="video/mp4" />
          Tu navegador no puede reproducir este video.
        </video>
        <div class="video-popup__final" id="video-popup-final">
          <h3>Escr&iacute;benos y te acompa&ntilde;amos paso a paso</h3>
          <p>Habla por WhatsApp con una asesora para resolver tus dudas y empezar con claridad.</p>
          <p class="video-popup__keywords">
            Si buscaste estudio webcam bogot&aacute;, modelo webcam bogot&aacute; o trabajo webcam bogot&aacute;,
            aqu&iacute; te orientamos de forma clara y privada.
          </p>
        </div>
        <a
          class="video-popup__cta"
          id="video-popup-cta"
          href={whatsappUrl}
          target="_blank"
          rel="noopener"
          data-analytics-event="click_popup_whatsapp"
          data-analytics-cta-location="popup"
          data-analytics-cta-type="whatsapp"
          data-analytics-cta-text="Hablar por WhatsApp desde video"
          data-analytics-whatsapp-type="popup_video_cta"
        >
          Hablar por WhatsApp ahora
        </a>
      </div>
    </section>

    <section class="confianza-hero" aria-labelledby="confianza-title">
      <div class="confianza-hero__bg" aria-hidden="true"></div>
      <div class="confianza-hero__overlay" aria-hidden="true"></div>

      <Container>
        <div class="confianza-hero__grid">
          <div class="confianza-hero__copy">
            <span class="eyebrow">Gold Models Studio</span>
            <h1 id="confianza-title">Estudio profesional con acompa&ntilde;amiento desde el primer d&iacute;a</h1>
            <p class="confianza-lead">
              Recibe orientaci&oacute;n, capacitaci&oacute;n y privacidad en un proceso claro para tomar una decisi&oacute;n informada.
            </p>
            <div class="cta-row hero-actions">
              <Button
                size="lg"
                variant="whatsapp"
                href={whatsappUrl}
                target="_blank"
                rel="noopener"
                data-analytics-event="click_primary_cta"
                data-analytics-cta-location="hero"
                data-analytics-cta-type="whatsapp"
                data-analytics-cta-text="Hablar con un asesor"
                data-analytics-whatsapp-type="hero_main_cta"
              >
                Habla con una asesora
              </Button>
              <p class="cta-microcopy">Atenci&oacute;n privada y sin compromiso</p>
            </div>
          </div>

          <aside class="trust-panel" aria-label="Pilares de acompa&ntilde;amiento">
            <span>Orientaci&oacute;n inicial</span>
            <span>Proceso claro y privado</span>
            <span>Acompa&ntilde;amiento profesional</span>
          </aside>
        </div>
      </Container>
    </section>

    <section class="section confianza-section" aria-labelledby="confianza-heading">
      <Container>
        <header class="section-head">
          <span class="eyebrow">Confianza</span>
          <h2 id="confianza-heading">Una forma de iniciar con claridad, privacidad y acompa&ntilde;amiento</h2>
          <p class="muted">
            Aqu&iacute; encontrar&aacute;s orientaci&oacute;n clara, privacidad y acompa&ntilde;amiento profesional para tomar una decisi&oacute;n informada.
          </p>
        </header>

        <div class="trust-grid">
          {trustItems.map((item) => (
            <article class="trust-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="section process-section" aria-labelledby="process-heading">
      <Container>
        <header class="section-head">
          <span class="eyebrow">C&oacute;mo te acompa&ntilde;amos</span>
          <h2 id="process-heading">Pasos simples, sin presi&oacute;n</h2>
        </header>

        <div class="process-list">
          {processSteps.map((step, index) => (
            <article class="process-step">
              <span class="process-step__number">{index + 1}</span>
              <h3>{step}</h3>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="section benefits-section" id="beneficios" aria-labelledby="benefits-heading">
      <Container>
        <header class="section-head section-head--center">
          <span class="eyebrow">Beneficios</span>
          <h2 id="benefits-heading">Lo que encuentras en Gold Models Studio</h2>
          <p class="muted">
            Un proceso claro con orientaci&oacute;n, acompa&ntilde;amiento y crecimiento seg&uacute;n tu dedicaci&oacute;n y desempe&ntilde;o.
          </p>
        </header>

        <div class="benefit-grid">
          {benefits.map((benefit) => (
            <article class="benefit-card">
              <span aria-hidden="true"></span>
              <h3>{benefit}</h3>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="section faq-section" id="faq" aria-labelledby="faq-heading">
      <Container>
        <header class="section-head section-head--center">
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2 id="faq-heading">Resuelve tus dudas antes de avanzar</h2>
        </header>

        <div class="faq-grid">
          {faqItems.map((item, index) => (
            <details
              class="faq-card"
              data-analytics-faq-id={`faq_${index + 1}`}
              data-analytics-faq-question={item.question}
            >
              <summary>
                <span class="faq-icon" aria-hidden="true">+</span>
                <h3>{item.question}</h3>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </Container>
    </section>

    <section class="section final-section" aria-labelledby="final-heading">
      <Container>
        <div class="final-card">
          <div>
            <span class="eyebrow">Siguiente paso</span>
            <h2 id="final-heading">Da el primer paso con acompa&ntilde;amiento profesional</h2>
            <p class="muted">Habla con un asesor y resuelve tus dudas por el canal oficial de WhatsApp.</p>
          </div>
          <Button
            size="lg"
            variant="whatsapp"
            href={whatsappUrl}
            target="_blank"
            rel="noopener"
            data-analytics-cta-location="footer"
            data-analytics-cta-text="Hablar por WhatsApp"
            data-analytics-whatsapp-type="footer_cta"
          >
            Hablar por WhatsApp
          </Button>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <StickyWhatsApp />
</BaseLayout>

<script is:inline>
  (() => {
    const popup = document.getElementById("video-popup");
    const closeButton = document.getElementById("video-popup-close");
    const video = document.getElementById("video-popup-player");
    const cta = document.getElementById("video-popup-cta");
    const finalState = document.getElementById("video-popup-final");

    if (
      !(popup instanceof HTMLElement) ||
      !(closeButton instanceof HTMLButtonElement) ||
      !(video instanceof HTMLVideoElement) ||
      !(cta instanceof HTMLAnchorElement) ||
      !(finalState instanceof HTMLElement)
    ) {
      return;
    }

    const search = new URLSearchParams(window.location.search);
    const adIdKeys = ["gclid", "gbraid", "wbraid", "fbclid", "msclkid", "ttclid"];
    const adSignals = [
      "google",
      "ads",
      "cpc",
      "ppc",
      "paid",
      "meta",
      "facebook",
      "instagram",
      "tiktok",
    ];

    const hasAdId = adIdKeys.some((key) => search.has(key));
    const utmMedium = (search.get("utm_medium") || "").toLowerCase();
    const utmSource = (search.get("utm_source") || "").toLowerCase();
    const utmCampaign = (search.get("utm_campaign") || "").toLowerCase();
    const combinedUtm = `${utmSource} ${utmMedium} ${utmCampaign}`;
    const hasAdUtm = adSignals.some((token) => combinedUtm.includes(token));
    const isAdTraffic = hasAdId || hasAdUtm;
    const utmTerm = search.get("utm_term") || "";

    const pushPopupEvent = (eventName, extraParams = {}) => {
      const analyticsWindow = window;
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.dataLayer.push({
        event: eventName,
        landing_variant: "landing_confianza",
        page_path: window.location.pathname,
        utm_source: utmSource || undefined,
        utm_medium: utmMedium || undefined,
        utm_campaign: utmCampaign || undefined,
        utm_term: utmTerm || undefined,
        ...extraParams,
      });
    };

    const revealFinalState = () => {
      if (popup.classList.contains("is-finished")) {
        return;
      }

      popup.classList.add("is-finished");
      video.classList.add("is-hidden");
      finalState.classList.add("is-visible");
      cta.classList.add("is-visible");
    };

    const openPopup = () => {
      popup.classList.add("is-open");
      document.body.classList.add("popup-lock-scroll");
      popup.setAttribute("aria-hidden", "false");

      video.muted = true;
      const autoplayAttempt = video.play();
      if (autoplayAttempt && typeof autoplayAttempt.catch === "function") {
        autoplayAttempt.catch(() => {
          // Autoplay can fail on some browsers; controls remain available for manual play.
        });
      }
    };

    const closePopup = () => {
      popup.classList.remove("is-open");
      document.body.classList.remove("popup-lock-scroll");
      popup.setAttribute("aria-hidden", "true");
      video.pause();
    };

    video.addEventListener("ended", () => {
      pushPopupEvent("popup_video_complete", {
        popup_variant: "video_popup_reel",
      });
      revealFinalState();
    });

    video.addEventListener("error", () => {
      revealFinalState();
    });

    closeButton.addEventListener("click", () => {
      closePopup();
    });

    popup.addEventListener("click", (event) => {
      if (event.target === popup) {
        event.preventDefault();
      }
    });

    popup.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
      }
    });

    window.addEventListener("load", () => {
      if (isAdTraffic) {
        openPopup();
        pushPopupEvent("popup_open", {
          popup_variant: "video_popup_reel",
          popup_trigger: "ad_traffic",
        });
      }
    });
  })();
</script>

<style>
  .video-popup {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background: rgba(15, 23, 42, 0.74);
    backdrop-filter: blur(3px);
  }

  .video-popup.is-open {
    display: flex;
  }

  .video-popup__surface {
    position: relative;
    width: min(760px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    overflow: auto;
    padding: clamp(18px, 3.4vw, 28px);
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--brand-gold) 34%, #ffffff);
    background: #fff;
    box-shadow: 0 28px 60px rgba(15, 23, 42, 0.34);
  }

  .video-popup__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--brand-gold) 18%, #fff);
    color: var(--text);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .video-popup.is-finished .video-popup__close {
    opacity: 1;
    pointer-events: auto;
  }

  .video-popup__copy {
    margin-top: 10px;
    margin-bottom: 14px;
  }

  .video-popup__player {
    width: 100%;
    border-radius: 12px;
    background: #0f172a;
    aspect-ratio: 9 / 16;
    max-height: min(64vh, 660px);
  }

  .video-popup__player.is-hidden {
    display: none;
  }

  .video-popup__final {
    display: none;
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--tint) 86%, #fff);
    border: 1px solid var(--border);
  }

  .video-popup__final h3 {
    margin: 0 0 6px;
  }

  .video-popup__final p {
    margin: 0;
  }

  .video-popup__keywords {
    margin-top: 8px;
    color: color-mix(in srgb, var(--text) 82%, transparent);
    font-size: 0.98rem;
  }

  .video-popup__final.is-visible {
    display: block;
  }

  .video-popup__cta {
    display: none;
    margin-top: 14px;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    width: 100%;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    background: #16a34a;
    color: #fff;
  }

  .video-popup__cta.is-visible {
    display: inline-flex;
  }

  :global(body.popup-lock-scroll) {
    overflow: hidden;
  }

  .confianza-page {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tint) 92%, #fff) 0%, #fff 64%),
      #fff;
  }

  .confianza-hero {
    position: relative;
    min-height: min(760px, calc(100vh - 98px));
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: clamp(64px, 9vw, 118px) 0;
  }

  .confianza-hero__bg {
    position: absolute;
    inset: 0;
    background-image: url("/images/hero-model.png");
    background-size: cover;
    background-position: center top;
    z-index: 0;
  }

  .confianza-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(255, 248, 235, 0.95) 0%, rgba(255, 248, 235, 0.82) 44%, rgba(255, 248, 235, 0.36) 74%, transparent 100%),
      linear-gradient(180deg, transparent 74%, rgba(255, 255, 255, 0.92) 100%);
    z-index: 1;
  }

  .confianza-hero :global(.container) {
    position: relative;
    z-index: 2;
  }

  .confianza-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(220px, 320px);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
  }

  .confianza-hero__copy h1 {
    max-width: 13ch;
    margin-top: 16px;
    margin-bottom: 20px;
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    font-weight: 600;
    line-height: 0.96;
  }

  .confianza-lead {
    max-width: 560px;
    margin-bottom: 26px;
    font-size: clamp(1.05rem, 1.8vw, 1.24rem);
  }

  .hero-actions {
    display: grid;
    gap: 10px;
    justify-items: start;
    align-items: center;
  }

  .hero-actions :global(.btn-whatsapp) {
    min-height: 56px;
    padding-inline: 26px;
    color: #fff;
    background: #16a34a;
    border-color: color-mix(in srgb, #0f7a37 34%, transparent);
    box-shadow: 0 16px 34px rgba(22, 163, 74, 0.32);
  }

  .hero-actions :global(.btn-whatsapp:hover) {
    background: #12813d;
    box-shadow: 0 18px 38px rgba(18, 129, 61, 0.36);
  }

  .hero-actions :global(.btn-whatsapp:focus-visible) {
    outline: 3px solid color-mix(in srgb, #16a34a 46%, #fff);
    outline-offset: 4px;
  }

  .cta-microcopy {
    margin: 0;
    color: color-mix(in srgb, var(--text) 76%, transparent);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .trust-panel {
    display: grid;
    gap: 12px;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.58);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-soft);
  }

  .trust-panel span {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, var(--brand-gold) 22%, transparent);
    border-radius: 12px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.72);
    font-weight: 700;
    line-height: 1.25;
  }

  .confianza-section,
  .benefits-section {
    background: #fff;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .trust-card,
  .benefit-card,
  .process-step,
  .faq-card,
  .final-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-soft);
  }

  .trust-card {
    padding: 18px;
  }

  .trust-card h3,
  .benefit-card h3,
  .process-step h3,
  .faq-card h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .trust-card p {
    margin-top: 10px;
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  .process-section,
  .faq-section,
  .final-section {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tint-2) 78%, #fff) 0%, #fff 100%);
  }

  .process-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }

  .process-step {
    min-height: 154px;
    padding: 18px;
    display: flex;
    flex-direction: column;

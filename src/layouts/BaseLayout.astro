---
import "../styles/global.css";
import type { SeoProps } from "../lib/seo";
import { buildSeo, seoDefaults } from "../lib/seo";

type LayoutProps = SeoProps & { schema?: unknown };

const { title, description, image, url }: SeoProps = buildSeo(Astro.props);
const { schema } = Astro.props as LayoutProps;
const canonical = url ?? Astro.site?.href ?? undefined;
const absoluteImage = image?.startsWith('http') ? image : new URL(image ?? '/images/og-image.png', Astro.site).href;
---

<!DOCTYPE html>
<html lang="es" data-theme="coral">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? seoDefaults.description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? seoDefaults.title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" sizes="any" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/images/icons/gold-models-dorado.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? seoDefaults.title} />
    <meta property="og:description" content={description ?? seoDefaults.description} />
    <meta property="og:image" content={absoluteImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Gold Models" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? seoDefaults.title} />
    <meta name="twitter:description" content={description ?? seoDefaults.description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="theme-color" content="#b77a12" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    {schema && <script type="application/ld+json">{JSON.stringify(schema)}</script>}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <header class="top-bar">
      <div class="container top-bar__inner">
        <a class="brand" href="/">
          <img class="brand__logo" src="/images/icons/gold-models-dorado.png" alt="Gold Models Studio" width="160" height="80" />
        </a>
        <nav class="nav nav--desktop" aria-label="Navegación principal">
          <a class="nav__link" href="#beneficios">Por qué elegirnos</a>
          <a class="nav__link" href="#faq">FAQ</a>
        </nav>

        <details class="nav-toggle">
          <summary class="nav-toggle__button" aria-label="Abrir menú">
            <span class="nav-toggle__icon" aria-hidden="true"></span>
          </summary>
          <nav class="nav nav--mobile" aria-label="Navegación móvil">
            <a class="nav__link" href="#beneficios">Por qué elegirnos</a>
            <a class="nav__link" href="#faq">FAQ</a>
          </nav>
        </details>
      </div>
    </header>
    <script>
      document.querySelectorAll('.nav-toggle a').forEach((link) => {
        link.addEventListener('click', () => {
          link.closest('details')?.removeAttribute('open');
        });
      });
    </script>
    <slot />
  </body>
</html>

---
import "../styles/global.css";
import type { SeoProps } from "../lib/seo";
import { buildSeo, seoDefaults } from "../lib/seo";

const { title, description, image, url }: SeoProps = buildSeo(Astro.props);
const canonical = url ?? Astro.site?.href ?? undefined;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? seoDefaults.description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? seoDefaults.title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? seoDefaults.title} />
    <meta property="og:description" content={description ?? seoDefaults.description} />
    <meta property="og:image" content={image ?? seoDefaults.image} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? seoDefaults.title} />
    <meta name="twitter:description" content={description ?? seoDefaults.description} />
    <meta name="twitter:image" content={image ?? seoDefaults.image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <slot />
  </body>
</html>

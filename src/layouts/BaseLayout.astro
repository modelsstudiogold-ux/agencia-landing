---
import "../styles/global.css";
import type { SeoProps } from "../lib/seo";
import { buildSeo, seoDefaults } from "../lib/seo";

type LayoutProps = SeoProps & { schema?: unknown; landingVariant?: string };

const { title, description, image, url }: SeoProps = buildSeo(Astro.props);
const { schema } = Astro.props as LayoutProps;
const canonical = url ?? Astro.site?.href ?? undefined;
const absoluteImage = image?.startsWith('http') ? image : new URL(image ?? '/images/og-image.png', Astro.site).href;
const gtmContainerId = import.meta.env.PUBLIC_GTM_CONTAINER_ID ?? 'GTM-5G7V6P3H';
const landingVariant = (Astro.props as LayoutProps).landingVariant ?? 'landing_actual';
---

<!DOCTYPE html>
<html lang="es" data-theme="coral" data-landing-variant={landingVariant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? seoDefaults.description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? seoDefaults.title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/images/favicon-g.svg?v=1" />
    <link rel="shortcut icon" type="image/svg+xml" href="/images/favicon-g.svg?v=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/gold-models-dorado.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? seoDefaults.title} />
    <meta property="og:description" content={description ?? seoDefaults.description} />
    <meta property="og:image" content={absoluteImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Gold Models" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? seoDefaults.title} />
    <meta name="twitter:description" content={description ?? seoDefaults.description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="theme-color" content="#b77a12" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Cormorant+Garamond:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var currentPath = window.location.pathname;
        var normalizedPath = currentPath.replace(/\/{2,}/g, '/');

        if (normalizedPath !== currentPath) {
          window.history.replaceState(null, '', normalizedPath + window.location.search + window.location.hash);
        }
      })();
    </script>
    {gtmContainerId && (
      <script is:inline define:vars={{ gtmContainerId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer',gtmContainerId);
      </script>
    )}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
  </head>
  <body>
    {gtmContainerId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmContainerId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <header class="top-bar">
      <div class="container top-bar__inner">
        <a class="brand" href="/">
          <img class="brand__logo" src="/images/icons/gold-models-dorado.png" alt="Gold Models Studio" width="160" height="80" />
        </a>
        <nav class="nav nav--desktop" aria-label="Navegación principal">
          <a class="nav__link" href="#beneficios">Por qué elegirnos</a>
          <a class="nav__link" href="#faq">FAQ</a>
        </nav>

        <details class="nav-toggle">
          <summary class="nav-toggle__button" aria-label="Abrir menú">
            <span class="nav-toggle__icon" aria-hidden="true"></span>
          </summary>
          <nav class="nav nav--mobile" aria-label="Navegación móvil">
            <a class="nav__link" href="#beneficios">Por qué elegirnos</a>
            <a class="nav__link" href="#faq">FAQ</a>
          </nav>
        </details>
      </div>
    </header>
    <script>
      document.querySelectorAll('.nav-toggle a').forEach((link) => {
        link.addEventListener('click', () => {
          link.closest('details')?.removeAttribute('open');
        });
      });

      (function () {
        const analyticsWindow = window as Window & { dataLayer: Array<Record<string, unknown>> };
        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];

        const getLandingVariant = () => {
          const variant = document.documentElement.getAttribute('data-landing-variant');
          return variant || 'landing_actual';
        };

        const normalizePathname = (pathname: string) => {
          const collapsed = pathname.replace(/\/{2,}/g, '/');
          if (!collapsed.startsWith('/')) {
            return `/${collapsed}`;
          }

          return collapsed;
        };

        const getBaseParams = () => ({
          landing_variant: getLandingVariant(),
          page_path: normalizePathname(window.location.pathname),
          page_title: document.title,
        });

        const pushEvent = (eventName: string, params: Record<string, unknown>) => {
          analyticsWindow.dataLayer.push({
            event: eventName,
            ...getBaseParams(),
            ...params,
          });
        };

        const getUtmParams = () => {
          const query = new URLSearchParams(window.location.search);
          return {
            utm_source: query.get('utm_source') || undefined,
            utm_medium: query.get('utm_medium') || undefined,
            utm_campaign: query.get('utm_campaign') || undefined,
            utm_content: query.get('utm_content') || undefined,
            utm_term: query.get('utm_term') || undefined,
          };
        };

        const isWhatsAppUrl = (href: string | null | undefined): boolean => /wa\.me|whatsapp\.com/i.test(href || '');

        const parseAnalyticsParamsFromDataset = (dataset: DOMStringMap): Record<string, string> => {
          const params: Record<string, string> = {};

          Object.entries(dataset).forEach(([key, value]) => {
            if (!value || !key.startsWith('analytics') || key === 'analyticsEvent') {
              return;
            }

            const rawKey = key.slice('analytics'.length);
            if (!rawKey) {
              return;
            }

            const snakeKey = rawKey
              .replace(/^[A-Z]/, (s) => s.toLowerCase())
              .replace(/[A-Z]/g, (s) => `_${s.toLowerCase()}`);

            params[snakeKey] = value;
          });

          return params;
        };

        const sendLandingView = () => {
          pushEvent('landing_view', getUtmParams());
        };

        const setupScrollDepthTracking = () => {
          const fired = new Set();
          const thresholds = [50, 75];

          const onScroll = () => {
            const doc = document.documentElement;
            const total = doc.scrollHeight - window.innerHeight;
            if (total <= 0) {
              return;
            }

            const scrollPercent = Math.round((window.scrollY / total) * 100);

            thresholds.forEach((threshold) => {
              if (scrollPercent >= threshold && !fired.has(threshold)) {
                fired.add(threshold);
                pushEvent('scroll_depth', { scroll_percent: threshold });
              }
            });
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        };

        const setupClickTracking = () => {
          document.addEventListener('click', (event) => {
            const element = event.target instanceof Element ? event.target.closest('[data-analytics-event],a') : null;
            if (!element) {
              return;
            }

            if (element instanceof HTMLElement && element.dataset.analyticsEvent) {
              const customParams = parseAnalyticsParamsFromDataset(element.dataset);
              if (!customParams.cta_text) {
                const text = element.textContent?.trim();
                if (text) {
                  customParams.cta_text = text;
                }
              }

              pushEvent(element.dataset.analyticsEvent, customParams);
            }

            if (element instanceof HTMLAnchorElement && isWhatsAppUrl(element.href)) {
              const customParams = parseAnalyticsParamsFromDataset(element.dataset);

              pushEvent('click_whatsapp', {
                cta_location: customParams.cta_location || 'unknown',
                cta_text: customParams.cta_text || element.textContent?.trim() || 'WhatsApp',
                whatsapp_type: customParams.whatsapp_type || 'unknown',
              });
            }
          });
        };

        const setupFaqTracking = () => {
          document.querySelectorAll('details[data-analytics-faq-id]').forEach((node) => {
            if (!(node instanceof HTMLDetailsElement)) {
              return;
            }

            const detail = node;
            detail.addEventListener('toggle', () => {
              if (!detail.open) {
                return;
              }

              const faqId = detail.getAttribute('data-analytics-faq-id') || 'faq_unknown';
              const faqQuestion = detail.getAttribute('data-analytics-faq-question') || 'faq_unknown';

              pushEvent('faq_open', {
                faq_id: faqId,
                faq_question: faqQuestion,
              });
            });
          });
        };

        sendLandingView();
        setupScrollDepthTracking();
        setupClickTracking();
        setupFaqTracking();
      })();
    </script>
    <slot />
  </body>
</html>

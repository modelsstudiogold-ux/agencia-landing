---
import { WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../../lib/constants";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}?text=${encodeURIComponent(
  WHATSAPP_MESSAGE,
)}`;
---

<div class="wpp-wrap">
  <a class="wpp" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Contactar por WhatsApp">
    <span class="wpp__bubble" aria-hidden="true">
      <svg class="wpp__icon" viewBox="0 0 32 32">
        <path d="M16 3C9.4 3 4 8.2 4 14.7c0 2.4.8 4.6 2 6.5L4 29l7-2.1c1.7.9 3.6 1.3 5.5 1.3 6.6 0 12-5.2 12-11.7S22.6 3 16 3Zm0 2.3c5.3 0 9.7 4.2 9.7 9.4 0 5.2-4.3 9.4-9.7 9.4-1.7 0-3.4-.5-4.8-1.3l-.4-.2-4.1 1.2 1.3-3.9-.3-.4c-1-1.5-1.6-3.2-1.6-5 0-5.2 4.3-9.4 9.7-9.4Zm-5.4 4c-.1-.2-.3-.2-.5-.2h-.4c-.1 0-.3 0-.4.2-.1.2-1.1 1-.1 3.1.9 1.7 2.1 3.3 3.9 4.5 1.8 1.1 2.7 1.3 3.3 1.2.6-.1 1.6-.7 1.8-1.4.2-.7.2-1.2.2-1.3 0-.1-.1-.2-.3-.3-.2-.1-1.5-.7-1.7-.8-.2-.1-.4 0-.5.1-.1.1-.6.7-.7.9-.1.1-.2.1-.3 0-.1 0-.5-.2-1.1-.5-1-.6-1.6-1.4-1.8-1.6-.1-.1 0-.2.1-.3.1-.1.2-.2.3-.3.1-.1.1-.2.2-.3.1-.1.1-.2.2-.3.1-.1.1-.2 0-.3-.1-.1-.8-2.1-.9-2.3-.1-.2-.2-.2-.3-.2Z" />
      </svg>
    </span>
    <span class="wpp-tooltip" role="status" aria-live="polite">WhatsApp</span>
  </a>
</div>

<style>
  .wpp-wrap {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 900;
  }

  .wpp {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
    user-select: none;
    transition: transform 120ms ease;
  }

  .wpp:hover {
    transform: translateY(-1px);
  }

  .wpp__bubble {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--whatsapp);
    box-shadow: 0 14px 28px rgba(37, 211, 102, 0.28);
  }

  .wpp:hover .wpp__bubble {
    background: var(--whatsapp-hover);
    box-shadow: 0 16px 34px rgba(37, 211, 102, 0.34);
  }

  .wpp__icon {
    width: 32px;
    height: 32px;
    fill: #fff;
  }

  .wpp-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    bottom: 50%;
    transform: translateY(calc(50% + 6px));
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--whatsapp);
    border: 1px solid color-mix(in srgb, #000 12%, transparent);
    box-shadow: 0 14px 28px rgba(37, 211, 102, 0.28);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 140ms ease, transform 140ms ease;
    white-space: nowrap;
  }

  .wpp:hover .wpp-tooltip,
  .wpp:focus-visible .wpp-tooltip {
    opacity: 1;
    transform: translateY(50%);
  }

  .wpp:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--whatsapp) 70%, transparent);
    outline-offset: 4px;
    border-radius: 999px;
  }

  @media (max-width: 480px) {
    .wpp-wrap {
      right: 14px;
      bottom: 14px;
    }

    .wpp__bubble {
      width: 54px;
      height: 54px;
    }

    .wpp__icon {
      width: 26px;
      height: 26px;
    }

    .wpp-tooltip {
      display: none;
    }
  }
</style>

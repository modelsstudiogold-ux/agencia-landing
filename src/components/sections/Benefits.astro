---
import Container from "../ui/Container.astro";

const benefits = [
  {
    title: "Localización",
    desc: "Dos sedes en Bogotá (Modelia y Normandía) para entrevistas y acompañamiento presencial cuando aplique.",
    icon: "pin",
  },
  {
    title: "Apoyo al 100%",
    desc: "Guía paso a paso, soporte humano y un proceso claro para que empieces con tranquilidad.",
    icon: "help",
  },
  {
    title: "Privacidad",
    desc: "Manejamos tu información con discreción. Validamos +18 antes de agendar entrevista.",
    icon: "heart",
  },
];
---

<section class="section benefits" id="beneficios" aria-label="Por qué elegirnos">
  <Container>
    <header class="section-head section-head--center">
      <h2 class="headline">Por Qué Elegirnos</h2>
      <div class="rule" aria-hidden="true"></div>
    </header>
  </Container>

  <div class="band" role="presentation">
    <!-- Background image only inside band -->
    <div class="benefits-bg" aria-hidden="true"></div>
    <div class="benefits-overlay" aria-hidden="true"></div>

    <Container>
      <div class="list" aria-label="Beneficios">
        {benefits.map((item) => (
          <article class="item">
            <div class="icon" aria-hidden="true">
              {item.icon === "pin" && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 22s7-4.4 7-12a7 7 0 1 0-14 0c0 7.6 7 12 7 12Z" stroke="currentColor" stroke-width="1.6" />
                  <path d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.6" />
                </svg>
              )}
              {item.icon === "help" && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" stroke="currentColor" stroke-width="1.6" />
                  <path d="M9.6 9.2a2.5 2.5 0 1 1 3.9 2.1c-.9.6-1.5 1.1-1.5 2.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  <path d="M12 17h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                </svg>
              )}
              {item.icon === "heart" && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 21s-7-4.6-9.2-9.2C1.5 8.6 3.4 6 6.4 6c1.8 0 3.1 1 3.6 2 0.5-1 1.8-2 3.6-2 3 0 4.9 2.6 3.6 5.8C19 16.4 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                </svg>
              )}
            </div>
            <div class="copy">
              <h3>{item.title}</h3>
              <p class="muted">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </div>
</section>

<style>
  .benefits {
    position: relative;
  }

  /* Full-background image */
  .benefits-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/benefits-model.png');
    background-size: cover;
    background-position: left center;
    z-index: 0;
  }

  /* Gradient overlay – text on the RIGHT, model visible on the LEFT */
  .benefits-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      270deg,
      rgba(255, 248, 235, 0.94) 0%,
      rgba(255, 248, 235, 0.8) 40%,
      rgba(255, 248, 235, 0.35) 70%,
      transparent 100%
    );
    z-index: 1;
  }

  .benefits :global(.container) {
    position: relative;
    z-index: 2;
  }

  .section-head--center {
    text-align: center;
    margin-bottom: 18px;
  }

  .headline {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .rule {
    width: 220px;
    height: 1px;
    background: color-mix(in srgb, #000 55%, transparent);
    margin: 0 auto;
  }

  .band {
    position: relative;
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, #000 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, #000 8%, transparent);
    padding: clamp(28px, 5vw, 54px) 0;
  }

  .list {
    display: grid;
    gap: 18px;
    max-width: 420px;
    margin-left: auto;
  }

  .item {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 16px;
    align-items: start;
    background: rgba(255, 248, 235, 0.55);
    backdrop-filter: blur(6px);
    border-radius: 16px;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .icon {
    position: relative;
    width: 62px;
    height: 62px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    border: 4px solid color-mix(in srgb, #000 90%, transparent);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, #000 6%, transparent);
    color: color-mix(in srgb, #000 78%, transparent);
    background: rgba(255, 255, 255, 0.65);
  }

  .icon svg {
    display: block;
    margin: 0 auto;
  }

  .icon::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    pointer-events: none;
  }

  .icon svg path,
  .icon svg circle,
  .icon svg rect,
  .icon svg line {
    stroke: color-mix(in srgb, var(--primary) 80%, currentColor);
  }

  .copy h3 {
    margin: 0 0 6px;
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .copy p {
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .benefits-bg {
      background-size: cover;
      background-position: 35% top;
    }

    .benefits-overlay {
      background: linear-gradient(
        180deg,
        rgba(255, 248, 235, 0.75) 0%,
        rgba(255, 248, 235, 0.45) 45%,
        rgba(255, 248, 235, 0.15) 100%
      );
    }

    .list {
      max-width: 100%;
      margin-left: 0;
    }

    .item {
      background: rgba(255, 248, 235, 0.7);
    }

    .copy h3,
    .copy p {
      text-shadow: 0 1px 6px rgba(255, 248, 235, 0.5);
    }
  }
</style>

---
import Container from "../ui/Container.astro";

const benefits = [
  {
    title: "Localización",
    desc: "Dos sedes en Bogotá (Modelia y Normandía) para entrevistas y acompañamiento presencial cuando aplique.",
    icon: "pin",
  },
  {
    title: "Apoyo al 100%",
    desc: "Guía paso a paso, soporte humano y un proceso claro para que empieces con tranquilidad.",
    icon: "help",
  },
  {
    title: "Privacidad",
    desc: "Manejamos tu información con discreción. Validamos +18 antes de agendar entrevista.",
    icon: "heart",
  },
];
---

<section class="section" id="beneficios" aria-label="Por qué elegirnos">
  <Container>
    <header class="section-head section-head--center">
      <h2 class="headline">Por Qué Elegirnos</h2>
      <div class="rule" aria-hidden="true"></div>
    </header>
  </Container>

  <div class="band" role="presentation">
    <Container>
      <div class="band-grid">
        <div class="media" aria-hidden="true"></div>

        <div class="list" aria-label="Beneficios">
          {benefits.map((item) => (
            <article class="item">
              <div class="icon" aria-hidden="true">
                {item.icon === "pin" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 22s7-4.4 7-12a7 7 0 1 0-14 0c0 7.6 7 12 7 12Z" stroke="currentColor" stroke-width="1.6" />
                    <path d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                )}
                {item.icon === "help" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" stroke="currentColor" stroke-width="1.6" />
                    <path d="M9.6 9.2a2.5 2.5 0 1 1 3.9 2.1c-.9.6-1.5 1.1-1.5 2.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    <path d="M12 17h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                  </svg>
                )}
                {item.icon === "heart" && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 21s-7-4.6-9.2-9.2C1.5 8.6 3.4 6 6.4 6c1.8 0 3.1 1 3.6 2 0.5-1 1.8-2 3.6-2 3 0 4.9 2.6 3.6 5.8C19 16.4 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                  </svg>
                )}
              </div>
              <div class="copy">
                <h3>{item.title}</h3>
                <p class="muted">{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </div>
</section>

<style>
  .section-head--center {
    text-align: center;
    margin-bottom: 18px;
  }

  .headline {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .rule {
    width: 220px;
    height: 1px;
    background: color-mix(in srgb, #000 55%, transparent);
    margin: 0 auto;
  }

  .band {
    background: var(--tint-2);
    border-top: 1px solid color-mix(in srgb, #000 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, #000 8%, transparent);
    padding: clamp(28px, 5vw, 54px) 0;
  }

  .band-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(18px, 4vw, 44px);
    align-items: center;
  }

  .media {
    min-height: 300px;
    border-radius: 22px;
    border: 1px solid color-mix(in srgb, #000 10%, transparent);
    box-shadow: var(--shadow-soft);
    background:
      radial-gradient(540px 340px at 40% 35%, rgba(0, 0, 0, 0.18), transparent 62%),
      linear-gradient(120deg, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0.06)),
      url('/images/GoldModels.jpg');
    background-size: cover;
    background-position: center;
  }

  .list {
    display: grid;
    gap: 18px;
  }

  .item {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 16px;
    align-items: start;
  }

  .icon {
    width: 62px;
    height: 62px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    border: 2px solid color-mix(in srgb, #000 60%, transparent);
    color: color-mix(in srgb, #000 78%, transparent);
    background: color-mix(in srgb, #ffffff 30%, transparent);
  }

  .copy h3 {
    margin: 0 0 6px;
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .copy p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .band-grid {
      grid-template-columns: 1fr;
    }

    .media {
      min-height: 220px;
    }
  }
</style>

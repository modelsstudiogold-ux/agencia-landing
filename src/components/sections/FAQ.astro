---
import Container from "../ui/Container.astro";
import { FAQ_ITEMS } from "../../lib/constants";
---

<section class="section faq" id="faq" aria-label="Preguntas frecuentes">
  <Container>
    <header class="faq-head">
      <h2 class="faq-title">Preguntas Frecuentes</h2>
      <div class="faq-rule" aria-hidden="true"></div>
      <p class="faq-sub">Si aún tienes dudas, escribe por WhatsApp o aplica y te contactamos.</p>
    </header>

    <div class="faq-grid">
      {FAQ_ITEMS.map((item) => (
        <details class="faq-card">
          <summary class="faq-summary">
            <span class="faq-plus" aria-hidden="true">+</span>
            <span class="faq-q">{item.question}</span>
          </summary>
          <div class="faq-a">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>

<style>
  .faq {
    position: relative;
    overflow: hidden;
  }

  .faq::before {
    content: "G";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: clamp(240px, 42vw, 620px);
    font-weight: 700;
    color: rgba(2, 6, 23, 0.08);
    pointer-events: none;
    transform: translateX(8%) translateY(6%);
    z-index: 0;
  }

  .faq :global(.container) {
    position: relative;
    z-index: 1;
  }

  .faq-head {
    max-width: 820px;
    margin-bottom: 22px;
  }

  .faq-title {
    margin: 0 0 10px;
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: clamp(2rem, 3.2vw, 2.6rem);
  }

  .faq-rule {
    width: 220px;
    height: 2px;
    background: color-mix(in srgb, var(--text) 22%, transparent);
    border-radius: 99px;
    margin-bottom: 12px;
  }

  .faq-sub {
    margin: 0;
    color: var(--muted-text);
  }

  .faq-grid {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 981px) {
    .faq-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 18px;
      align-items: start;
    }
  }

  .faq-card {
    border: 1px solid color-mix(in srgb, #000 10%, transparent);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 0 10px 22px rgba(2, 6, 23, 0.08);
    overflow: hidden;
    backdrop-filter: blur(6px);
  }

  .faq-summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 16px;
    display: grid;
    grid-template-columns: 22px 1fr;
    align-items: center;
    gap: 12px;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-plus {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    color: var(--primary);
    font-weight: 900;
    line-height: 1;
    font-size: 1.15rem;
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    transition: transform 160ms ease, background 160ms ease;
  }

  .faq-q {
    font-weight: 700;
    color: color-mix(in srgb, var(--text) 92%, transparent);
    font-size: 0.98rem;
  }

  .faq-a {
    padding: 0 16px 14px;
  }

  .faq-a p {
    margin: 0;
    color: var(--muted-text);
  }

  details:not([open]) .faq-a {
    display: none;
  }

  details[open] .faq-plus {
    transform: rotate(45deg);
    background: color-mix(in srgb, var(--primary) 22%, transparent);
  }

  details[open] {
    background: rgba(255, 255, 255, 0.86);
  }

  .faq-summary:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--primary) 55%, transparent);
    outline-offset: 2px;
    border-radius: 12px;
  }
</style>

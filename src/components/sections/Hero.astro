---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { AGENCY_NAME, BRAND_TAGLINE, WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../../lib/constants";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---

<section class="section hero" id="contenido">
  <Container>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">
          Sácale partido a tu potencial
          <span class="hero-title__line">en un estudio con guía real</span>
        </h1>

        <p class="lead">
          {BRAND_TAGLINE}. Canal oficial por WhatsApp para resolver dudas y agendar entrevista.
        </p>

        <div class="cta-row hero-cta">
          <Button size="lg" variant="whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
            Hablar por WhatsApp
          </Button>
        </div>
      </div>

		<div class="hero-media" aria-hidden="true"></div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-top: clamp(42px, 7vw, 84px);
    padding-bottom: clamp(40px, 7vw, 84px);
    min-height: 72vh;
    display: flex;
    align-items: center;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0) 62%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--primary) 44%, #ffffff) 0%,
        color-mix(in srgb, var(--tint) 86%, #ffffff) 70%,
        #ffffff 100%
      );
  }

  .hero-grid {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    align-items: center;
  }

  .hero-media {
    display: none;
    min-height: 520px;
    border-radius: 22px;
    border: 1px solid color-mix(in srgb, #000 10%, transparent);
    box-shadow: var(--shadow-soft);
    background:
      radial-gradient(560px 360px at 36% 32%, rgba(0, 0, 0, 0.22), transparent 62%),
      linear-gradient(120deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.06)),
      url('/images/GoldModels.jpg');
    background-size: cover;
    background-position: center;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--muted-text);
    max-width: 680px;
    margin-bottom: 18px;
  }

  .hero-title {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--text);
    font-size: clamp(3rem, 5vw, 4.2rem);
    line-height: 0.95;
    margin-bottom: 12px;
  }

  .hero-title__line {
    display: block;
  }

  .hero-cta {
    margin-top: 10px;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(24px, 4vw, 54px);
    }

    .hero-media {
      display: block;
    }
  }

  @media (max-width: 980px) {
    .hero-title {
      color: #fff;
      text-shadow: 0 18px 34px rgba(2, 6, 23, 0.22);
    }
  }

  @media (max-width: 560px) {
    .hero {
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--primary) 76%, #000000) 0%,
				color-mix(in srgb, var(--primary) 60%, #000000) 100%
			);
    }

    .hero-title {
      color: #fff;
      text-shadow: 0 18px 34px rgba(2, 6, 23, 0.22);
			max-width: 18ch;
			text-wrap: balance;
    }

    .lead {
      color: color-mix(in srgb, #ffffff 82%, transparent);
    }

    .hero-cta :global(.btn-whatsapp) {
      color: #fff;
    }

    .hero-cta :global(.btn-whatsapp:hover) {
      color: #fff;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

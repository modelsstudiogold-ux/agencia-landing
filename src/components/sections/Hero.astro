---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { AGENCY_NAME, BRAND_TAGLINE, WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../../lib/constants";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---

<section class="section hero" id="contenido">
  <!-- Full-background image (like ambicion.studio) -->
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-overlay" aria-hidden="true"></div>

  <Container>
    <div class="hero-copy">
      <h1 class="hero-title">
        Sácale partido a tu potencial
        <span class="hero-title__line">en un estudio con guía real</span>
      </h1>

      <p class="lead">
        {BRAND_TAGLINE}. Canal oficial por WhatsApp para resolver dudas y agendar entrevista.
      </p>

      <div class="cta-row hero-cta">
        <Button size="lg" variant="whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
          Hablar por WhatsApp
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(80px, 14vw, 160px);
    padding-bottom: clamp(80px, 14vw, 160px);
    min-height: 85vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* Full-background image */
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/hero-model.png');
    background-size: cover;
    background-position: center top;
    z-index: 0;
  }

  /* Gradient overlay so text remains readable */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 248, 235, 0.92) 0%,
      rgba(255, 248, 235, 0.75) 40%,
      rgba(255, 248, 235, 0.3) 70%,
      transparent 100%
    );
    z-index: 1;
  }

  .hero :global(.container) {
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    max-width: 580px;
  }

  .hero-title {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--text);
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    line-height: 0.95;
    margin-bottom: 18px;
  }

  .hero-title__line {
    display: block;
  }

  .lead {
    font-size: 1.08rem;
    color: var(--muted-text);
    max-width: 480px;
    margin-bottom: 22px;
    line-height: 1.6;
  }

  .hero-cta {
    margin-top: 10px;
  }

  /* Mobile: overlay covers more so text is always readable */
  @media (max-width: 768px) {
    .hero {
      min-height: 75vh;
    }

    .hero-overlay {
      background: linear-gradient(
        180deg,
        rgba(255, 248, 235, 0.55) 0%,
        rgba(255, 248, 235, 0.35) 40%,
        rgba(255, 248, 235, 0.15) 100%
      );
    }

    .hero-copy {
      max-width: 100%;
      text-shadow: 0 1px 8px rgba(255, 248, 235, 0.6);
    }

    .hero-title {
      max-width: 16ch;
      text-wrap: balance;
      text-shadow: 0 1px 12px rgba(255, 248, 235, 0.8);
    }

    .lead {
      text-shadow: 0 1px 6px rgba(255, 248, 235, 0.5);
    }
  }
</style>

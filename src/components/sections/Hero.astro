---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { AGENCY_NAME, BRAND_TAGLINE, HERO_BENEFITS, WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../../lib/constants";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;
---

<section class="section hero" id="contenido">
  <Container>
    <div class="hero-grid">
      <div class="hero-copy">
        <img src="/images/logo-coral.svg" alt="Gold Models" class="brand-mark" width="180" height="110" loading="eager" />
        <span class="eyebrow">Talento remoto • +18</span>
        <h1>{AGENCY_NAME}</h1>
        <p class="lead">
          {BRAND_TAGLINE}. Proceso guiado, pagos transparentes y soporte humano para que te enfoques en crecer.
        </p>

        <ul class="list-clean bullets">
          {HERO_BENEFITS.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        <div class="cta-row">
          <Button size="lg" variant="whatsapp" href={whatsappUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 32 32" aria-hidden="true" width="20" height="20">
              <path d="M16 3C9.4 3 4 8.2 4 14.7c0 2.4.8 4.6 2 6.5L4 29l7-2.1c1.7.9 3.6 1.3 5.5 1.3 6.6 0 12-5.2 12-11.7S22.6 3 16 3Zm0 2.3c5.3 0 9.7 4.2 9.7 9.4 0 5.2-4.3 9.4-9.7 9.4-1.7 0-3.4-.5-4.8-1.3l-.4-.2-4.1 1.2 1.3-3.9-.3-.4c-1-1.5-1.6-3.2-1.6-5 0-5.2 4.3-9.4 9.7-9.4Zm-5.4 4c-.1-.2-.3-.2-.5-.2h-.4c-.1 0-.3 0-.4.2-.1.2-1.1 1-.1 3.1.9 1.7 2.1 3.3 3.9 4.5 1.8 1.1 2.7 1.3 3.3 1.2.6-.1 1.6-.7 1.8-1.4.2-.7.2-1.2.2-1.3 0-.1-.1-.2-.3-.3-.2-.1-1.5-.7-1.7-.8-.2-.1-.4 0-.5.1-.1.1-.6.7-.7.9-.1.1-.2.1-.3 0-.1 0-.5-.2-1.1-.5-1-.6-1.6-1.4-1.8-1.6-.1-.1 0-.2.1-.3.1-.1.2-.2.3-.3.1-.1.1-.2.2-.3.1-.1.1-.2.2-.3.1-.1.1-.2 0-.3-.1-.1-.8-2.1-.9-2.3-.1-.2-.2-.2-.3-.2Z" />
            </svg>
            Hablar por WhatsApp
          </Button>
        </div>
        <p class="muted note">Sin costos de inscripción. Confirmamos mayoría de edad (+18) antes de continuar.</p>
      </div>
      <div class="hero-card card">
        <p class="badge">Onboarding rápido</p>
        <h3>¿Qué obtienes?</h3>
        <ul class="list-clean perks">
          <li><strong>Soporte dedicado:</strong> equipo disponible para resolver dudas en tiempo real.</li>
          <li><strong>Playbooks de calidad:</strong> guías prácticas para maximizar tus resultados.</li>
          <li><strong>Pagos claros:</strong> calendario y seguimiento de cada ciclo de pago.</li>
        </ul>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 96px);
  }

  .hero-grid {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: center;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 680px;
    margin-bottom: 18px;
  }

  .bullets {
    display: grid;
    gap: 10px;
    margin: 0 0 18px;
    padding: 0;
  }

  .bullets li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 600;
  }

  .bullets li::before {
    content: "✓";
    color: var(--primary);
    font-size: 1.1rem;
    font-weight: 800;
  }

  .hero-card {
    background: var(--surface);
  }

  .brand-mark {
    width: 170px;
    height: auto;
    margin-bottom: 12px;
  }

  .perks {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 12px 0 0;
    color: var(--muted);
  }

  .note {
    margin-top: 10px;
  }
</style>

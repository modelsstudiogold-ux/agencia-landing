---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../../lib/constants";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}?text=${encodeURIComponent(
  "Hola, me gustaría conocer más sobre los convenios disponibles para modelos activas."
)}`;

const convenios = [
  {
    title: "Psicología",
    desc: "Acompañamiento emocional con profesionales.",
    image: "/images/convenios/psicologia.jpeg",
  },
  {
    title: "Estudio de Tatuajes",
    desc: "Precios especiales en tatuajes y diseños.",
    image: "/images/convenios/tatuajes.jpeg",
  },
  {
    title: "Spa para Uñas",
    desc: "Manicure, pedicure y diseños con descuento.",
    image: "/images/convenios/unas.jpeg",
  },
  {
    title: "Estética de Belleza",
    desc: "Tratamientos y servicios de belleza exclusivos.",
    image: "/images/convenios/estetica.jpeg",
  },
  {
    title: "Tienda de Celulares",
    desc: "Descuentos en equipos y accesorios.",
    image: "/images/convenios/celulares.jpeg",
  },
  {
    title: "Cejas y Pestañas",
    desc: "Diseño de cejas, extensiones y laminado.",
    image: "/images/convenios/cejas-pestanas.jpeg",
  },
  {
    title: "Fotografía Profesional",
    desc: "Sesiones para book y portafolio.",
    image: "/images/convenios/fotografia.jpeg",
  },
  {
    title: "Bienestar y cuidado personal",
    desc: "Convenios pensados para apoyar tu bienestar, cuidado personal y comodidad durante el proceso.",
    image: "/images/convenios/sex-shop.jpeg",
  },
];
---

<section class="section" id="convenios" aria-label="Nuestros Convenios">
  <Container>
    <header class="section-head section-head--center">
      <h2 class="headline">Nuestros Convenios</h2>
      <div class="rule" aria-hidden="true"></div>
      <p class="muted">Beneficios exclusivos para modelos activas del estudio.</p>
    </header>
  </Container>

  <div class="band">
    <Container>
      <div class="icons" role="list">
        {convenios.map((item) => (
          <article class="icon-card" role="listitem">
            <div class="icon" aria-hidden="true">
              {item.image ? (
                <img
                  src={item.image}
                  alt={`Logo ${item.title}`}
                  class="icon-img"
                  loading="lazy"
                  width="84"
                  height="84"
                />
              ) : (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm-1 14H9V8h2v8Zm4 0h-2V8h2v8Z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M4.5 19.5 8 16m12-12-3.5 3.5M4.5 4.5 8 8m8 8 3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              )}
            </div>
            <h3 class="icon-title">{item.title}</h3>
            <p class="icon-desc">{item.desc}</p>
          </article>
        ))}
      </div>

      <div class="cta">
        <p class="quote">"Tu bienestar también es parte de nuestra prioridad"</p>
        <Button variant="whatsapp" size="lg" href={whatsappUrl} target="_blank" rel="noopener">Pregunta por convenios</Button>
      </div>
    </Container>
  </div>
</section>

<style>
  .section-head--center {
    text-align: center;
    margin-bottom: 18px;
  }

  .headline {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .rule {
    width: 260px;
    height: 1px;
    background: color-mix(in srgb, #000 55%, transparent);
    margin: 0 auto;
  }

  .band {
    position: relative;
    background: #f3f4f6;
    border-top: 1px solid color-mix(in srgb, #000 10%, transparent);
    border-bottom: 1px solid color-mix(in srgb, #000 10%, transparent);
    padding: clamp(34px, 6vw, 76px) 0;
    overflow: hidden;
  }

  .band::before {
    content: "G";
    position: absolute;
    inset: auto 0 50% 0;
    transform: translateY(50%);
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: min(48vw, 560px);
    line-height: 0.85;
    text-align: center;
    color: rgba(0, 0, 0, 0.06);
    pointer-events: none;
    user-select: none;
  }

  .icons {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(150px, 1fr));
    gap: 28px 22px;
    align-items: start;
    justify-items: center;
    width: 100%;
  }

  .icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 170px;
    justify-self: center;
  }

  .icon {
    position: relative;
    width: 84px;
    height: 84px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    border: 4px solid color-mix(in srgb, #000 90%, transparent);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, #000 6%, transparent);
    background: rgba(255, 255, 255, 0.65);
    color: color-mix(in srgb, #000 85%, transparent);
    margin-bottom: 10px;
    overflow: hidden;
  }

  .icon-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px;
    display: block;
  }

  .icon svg {
    display: block;
    margin: 0 auto;
  }

  .icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    pointer-events: none;
  }

  .icon svg path,
  .icon svg circle,
  .icon svg rect,
  .icon svg line {
    stroke: color-mix(in srgb, var(--primary) 80%, currentColor);
  }

  .icon-title {
    margin: 0 0 4px;
    font-weight: 600;
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.1;
  }

  .icon-desc {
    margin: 0;
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--text) 70%, transparent);
  }

  .cta {
    position: relative;
    z-index: 1;
    margin-top: clamp(28px, 5vw, 54px);
    text-align: center;
  }

  .quote {
    margin: 0 0 14px;
    font-style: italic;
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    color: color-mix(in srgb, var(--text) 85%, transparent);
  }

  @media (max-width: 980px) {
    .icons {
      grid-template-columns: repeat(3, minmax(140px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .icons {
      grid-template-columns: repeat(2, minmax(120px, 1fr));
    }

    .icon-card {
      max-width: none;
    }
  }
</style>

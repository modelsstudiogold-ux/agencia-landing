---
import Container from "../ui/Container.astro";

const team = [
  {
    key: "gerencia",
    title: "Gerencia",
    role: "Dirección principal",
    desc: "Define la visión, el estándar de calidad y los lineamientos de acompañamiento para todo el equipo.",
    image: "/images/GoldModels.jpg",
  },
  {
    key: "administrativa",
    title: "Administrativa",
    role: "Operación y agenda",
    desc: "Organiza el día a día, coordina entrevistas y asegura una comunicación clara con cada candidata.",
    image: "/images/GoldModels.jpg",
  },
  {
    key: "contable",
    title: "Contable",
    role: "Pagos y soporte",
    desc: "Gestiona pagos y documentación para que todo el proceso sea transparente y ordenado.",
    image: "/images/GoldModels.jpg",
  },
  {
    key: "marketing",
    title: "Marketing",
    role: "Promoción y comunicación",
    desc: "Diseña campañas, gestiona redes y posiciona la marca para atraer talento y oportunidades.",
    image: "/images/GoldModels.jpg",
  },
] as const;
---

<section class="section" id="equipo" aria-label="Equipo de trabajo">
  <Container>
    <header class="section-head section-head--center">
      <h2 class="headline">Equipo de Trabajo</h2>
      <div class="rule" aria-hidden="true"></div>
    </header>
  </Container>

  <div class="band" role="presentation">
    <Container>
    <!-- Carousel + info panel wrapper -->
    <div class="team-stage" id="teamStage" tabindex="0">
      <!-- Cards layer -->
      <div class="team-cards">
        {team.map((member, i) => (
          <article
            class={`team-card ${i === 0 ? "active" : ""}`}
            data-index={i}
            style={`background-image: url('${member.image}')`}
          >
            <div class="card-overlay"></div>
            <span class="card-label">{member.title}</span>
          </article>
        ))}
      </div>

      <!-- Info panel (shows data for active card) -->
      <div class="team-info" id="teamInfo">
        <h3 class="info-title" id="infoTitle">{team[0].title}</h3>
        <p class="info-desc" id="infoDesc">{team[0].desc}</p>
      </div>
    </div>

    <!-- Dot indicators -->
    <div class="team-dots" id="teamDots">
      {team.map((_, i) => (
        <button
          class={`dot ${i === 0 ? "active" : ""}`}
          data-index={i}
          aria-label={`Ir a ${team[i].title}`}
        />
      ))}
    </div>
    </Container>
  </div>
</section>

<style>
  /* ── Header (matches Benefits) ── */
  .section-head--center {
    text-align: center;
    margin-bottom: 18px;
  }

  .headline {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .rule {
    width: 220px;
    height: 1px;
    background: color-mix(in srgb, #000 55%, transparent);
    margin: 0 auto;
  }

  .band {
    background: var(--tint-2);
    border-top: 1px solid color-mix(in srgb, #000 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, #000 8%, transparent);
    padding: clamp(28px, 5vw, 54px) 0;
  }

  /* ── Stage: cards + info panel side by side ── */
  .team-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    position: relative;
    min-height: 380px;
    outline: none;
  }

  /* ── Cards stack (perspective carousel) ── */
  .team-cards {
    position: relative;
    width: min(480px, 50vw);
    height: 420px;
    flex-shrink: 0;
  }

  .team-card {
    position: absolute;
    inset: 0;
    border-radius: 18px;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(.4,.9,.3,1),
                opacity 0.5s ease,
                box-shadow 0.5s ease,
                z-index 0s;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.55) 100%);
    border-radius: 18px;
  }

  .card-label {
    position: absolute;
    bottom: 18px;
    left: 18px;
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    z-index: 2;
    text-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }

  /* Card states – managed by JS via data-pos attribute */
  /* Center */
  .team-card[data-pos="0"] {
    transform: translateX(0) scale(1);
    opacity: 1;
    z-index: 5;
    box-shadow: 0 24px 60px rgba(0,0,0,0.22);
  }

  /* Right +1 (peeking) */
  .team-card[data-pos="1"] {
    transform: translateX(55%) scale(0.85);
    opacity: 0.7;
    z-index: 3;
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
  }

  /* Right +2 (far) */
  .team-card[data-pos="2"] {
    transform: translateX(95%) scale(0.72);
    opacity: 0.4;
    z-index: 1;
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
  }

  /* Left -1 (peeking) */
  .team-card[data-pos="-1"] {
    transform: translateX(-55%) scale(0.85);
    opacity: 0.7;
    z-index: 3;
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
  }

  /* Left -2 (far) */
  .team-card[data-pos="-2"] {
    transform: translateX(-95%) scale(0.72);
    opacity: 0.4;
    z-index: 1;
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
  }

  /* Hidden (overflow cards) */
  .team-card[data-pos="hidden"] {
    transform: translateX(120%) scale(0.6);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* ── Info panel ── */
  .team-info {
    background: rgba(255,255,255,0.96);
    border: 1px solid color-mix(in srgb, #000 8%, transparent);
    border-radius: 18px;
    padding: clamp(24px, 3vw, 40px);
    max-width: 360px;
    width: 100%;
    margin-left: -40px;
    z-index: 6;
    box-shadow: 0 16px 48px rgba(0,0,0,0.10);
    transition: opacity 0.3s ease;
  }

  .info-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--brand-gold);
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .info-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }

  /* ── Dots ── */
  .team-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(24px, 4vw, 40px);
  }

  .dot {
    width: 32px;
    height: 6px;
    border-radius: 999px;
    border: 0;
    background: #d1d5db;
    cursor: pointer;
    transition: background 0.3s, width 0.3s;
    padding: 0;
  }

  .dot.active {
    background: var(--brand-gold);
    width: 44px;
  }

  /* ── Mobile responsive ── */
  @media (max-width: 768px) {
    .team-stage {
      flex-direction: column;
      min-height: auto;
      gap: 0;
    }

    .team-cards {
      width: 85vw;
      max-width: 360px;
      height: 300px;
    }

    .team-info {
      margin-left: 0;
      margin-top: -20px;
      max-width: 85vw;
      border-top-left-radius: 0;
      border-top-right-radius: 0;
    }

    /* Mobile: only show active card, hide lateral cards */
    .team-card[data-pos="1"],
    .team-card[data-pos="-1"],
    .team-card[data-pos="2"],
    .team-card[data-pos="-2"],
    .team-card[data-pos="hidden"] {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.85);
    }

    .team-card[data-pos="0"] {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }
  }
</style>

<script type="module">
  const stage = document.getElementById('teamStage');
  if (!stage) throw new Error('teamStage not found');

  const cards = Array.from(stage.querySelectorAll('.team-card'));
  const dots = Array.from(document.querySelectorAll('#teamDots .dot'));
  const infoTitle = document.getElementById('infoTitle');
  const infoDesc = document.getElementById('infoDesc');
  const total = cards.length;

  // Data embedded from Astro (read from DOM)
  const teamData = cards.map(card => ({
    title: card.querySelector('.card-label')?.textContent || '',
    desc: card.getAttribute('data-desc') || '',
  }));

  // We'll store descriptions as data attributes so JS can read them
  const descriptions = [
    "Define la visión, el estándar de calidad y los lineamientos de acompañamiento para todo el equipo.",
    "Organiza el día a día, coordina entrevistas y asegura una comunicación clara con cada candidata.",
    "Gestiona pagos y documentación para que todo el proceso sea transparente y ordenado.",
    "Diseña campañas, gestiona redes y posiciona la marca para atraer talento y oportunidades.",
  ];

  let current = 0;

  function update(index) {
    current = ((index % total) + total) % total; // wrap around

    // Position each card relative to current
    cards.forEach((card, i) => {
      let diff = i - current;
      // Wrap for circular feeling
      if (diff > Math.floor(total / 2)) diff -= total;
      if (diff < -Math.floor(total / 2)) diff += total;

      if (diff >= -2 && diff <= 2) {
        card.setAttribute('data-pos', String(diff));
      } else {
        card.setAttribute('data-pos', 'hidden');
      }
    });

    // Update info panel
    if (infoTitle) infoTitle.textContent = cards[current].querySelector('.card-label')?.textContent || '';
    if (infoDesc) infoDesc.textContent = descriptions[current] || '';

    // Update dots
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === current);
    });
  }

  // Initialize
  update(0);

  // Click on cards
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const idx = Number(card.dataset.index);
      update(idx);
    });
  });

  // Click on dots
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      update(Number(dot.dataset.index));
    });
  });

  // Keyboard navigation
  stage.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); update(current - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); update(current + 1); }
  });
</script>

---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { BASE_WHATSAPP_MESSAGE, LOCATIONS, WHATSAPP_NUMBER } from "../../lib/constants";

const baseNumber = WHATSAPP_NUMBER.replace(/\D/g, "");
const buildWhatsappUrl = (locationName: string) => {
  const message = `${BASE_WHATSAPP_MESSAGE}\n\nMe interesa la sede: ${locationName} (Bogota).`;
  return `https://wa.me/${baseNumber}?text=${encodeURIComponent(message)}`;
};
const buildCtaLocation = (locationName: string) => locationName
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase();
---

<section class="section" id="sedes">
  <Container>
    <header class="section-head section-head--center">
      <h2 class="headline">Sedes Disponibles</h2>
      <div class="rule" aria-hidden="true"></div>
      <p class="muted">Elige la sede que te quede mejor. Te explicamos el proceso, resolvemos dudas y confirmamos requisitos (+18) antes de agendar.</p>
    </header>
  </Container>

  <div class="band" role="presentation">
    <Container>
    <div class="grid locations">
      {LOCATIONS.map((location) => (
        <article class="card location" aria-label={`Sede ${location.name}`}>
          <div class="location__top">
            <h3>{location.name}</h3>
            <p class="muted">{location.zone}</p>
          </div>
          <p>{location.description}</p>
          <div class="cta-row">
            <Button
              variant="whatsapp"
              href={buildWhatsappUrl(location.name)}
              target="_blank"
              rel="noopener"
              data-analytics-cta-location={buildCtaLocation(location.name)}
              data-analytics-whatsapp-type="location_cta"
              data-analytics-landing-type="base"
              data-analytics-source="google_ads_base"
            >
              Preguntar por {location.name}
            </Button>
          </div>
        </article>
      ))}
    </div>
    </Container>
  </div>
</section>

<style>
  .section-head--center {
    text-align: center;
    margin-bottom: 18px;
  }

  .headline {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .rule {
    width: 220px;
    height: 1px;
    background: color-mix(in srgb, #000 55%, transparent);
    margin: 0 auto;
  }

  .band {
    background: var(--tint-2);
    border-top: 1px solid color-mix(in srgb, #000 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, #000 8%, transparent);
    padding: clamp(28px, 5vw, 54px) 0;
  }

  .locations {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .location {
    display: grid;
    gap: 10px;
  }

  .location__top {
    display: grid;
    gap: 2px;
  }

</style>

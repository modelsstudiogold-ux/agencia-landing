---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { BASE_WHATSAPP_MESSAGE, WHATSAPP_NUMBER } from "../../lib/constants";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER.replace(/\D/g, "")}?text=${encodeURIComponent(BASE_WHATSAPP_MESSAGE)}`;

const items = [
  {
    title: "Entorno de estudio",
    desc: "Espacios listos y seguros.",
    icon: "room",
  },
  {
    title: "Redes y guía",
    desc: "Te ayudamos a arrancar.",
    icon: "social",
  },
  {
    title: "Vestuario",
    desc: "Accesorios cuando aplique.",
    icon: "outfit",
  },
  {
    title: "Maquillaje",
    desc: "Productos para tus looks.",
    icon: "makeup",
  },
  {
    title: "Tecnología",
    desc: "Herramientas de apoyo para iniciar.",
    icon: "tech",
  },
];
---

<section class="section" aria-label="Lo que proporcionamos">
  <Container>
    <header class="section-head section-head--center">
      <h2 class="headline">Lo que Proporcionamos</h2>
      <div class="rule" aria-hidden="true"></div>
    </header>
  </Container>

  <div class="band">
    <Container>
      <div class="icons" role="list">
        {items.map((item) => (
          <article class={`icon-card icon-${item.icon}`} role="listitem">
            <div class="icon" aria-hidden="true">
              {item.icon === "room" && (
                <svg width="30" height="30" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <!-- Bed: subtle mattress fill with primary, outlines in currentColor -->
                  <rect x="3" y="11" width="18" height="5" rx="0.6" fill="var(--primary)" opacity="0.12" />
                  <rect x="3" y="11" width="18" height="5" rx="0.6" stroke="currentColor" stroke-width="1.4" fill="none" />
                  <!-- Headboard -->
                  <path d="M4 11V7a2 2 0 0 1 2-2h12v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                  <!-- Pillow accent -->
                  <rect x="5.2" y="12" width="4.8" height="2" rx="0.4" fill="var(--primary)" opacity="0.22" stroke="currentColor" stroke-width="0.9" />
                  <!-- Bed legs -->
                  <rect x="3.5" y="16" width="1" height="1.6" rx="0.2" fill="currentColor" />
                  <rect x="19.5" y="16" width="1" height="1.6" rx="0.2" fill="currentColor" />
                </svg>
              )}
              {item.icon === "social" && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M16 7.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" stroke="currentColor" stroke-width="1.6" />
                  <path d="M4 20a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              )}
              {item.icon === "outfit" && (
                <svg width="48" height="48" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"> <path d="M7 2.5C7 2 8 2 9 3s2 1 2 1 1-1 2-1 2-1 2.5-.5S19 3 18 4c-.5 1-2 3-2 3l1 6L12 21 7 13.9l1-6s-1.5-2-2-3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/> </svg>
              )}
              {item.icon === "makeup" && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 3h4v6h-4V3Z" stroke="currentColor" stroke-width="1.6" />
                  <path d="M9 9h6l-1 12H10L9 9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                  <path d="M9.5 13h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              )}
              {item.icon === "tech" && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 5h16v11H4V5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                  <path d="M8 19h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  <path d="M12 16v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              )}
            </div>
            <h3 class="icon-title">{item.title}</h3>
            <p class="icon-desc">{item.desc}</p>
          </article>
        ))}
      </div>

      <div class="cta">
        <p class="quote">“No te preocupes, ¡no necesitas traer nada! ¡Lo tenemos TODO preparado para ti!”</p>
        <Button
          variant="whatsapp"
          size="lg"
          href={whatsappUrl}
          target="_blank"
          rel="noopener"
          data-analytics-cta-location="provisions"
          data-analytics-whatsapp-type="section_cta"
          data-analytics-landing-type="base"
          data-analytics-source="google_ads_base"
        >
          Enviar un WhatsApp
        </Button>
      </div>
    </Container>
  </div>
</section>

<style>
  .section-head--center {
    text-align: center;
    margin-bottom: 18px;
  }

  .headline {
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .rule {
    width: 260px;
    height: 1px;
    background: color-mix(in srgb, #000 55%, transparent);
    margin: 0 auto;
  }

  .band {
    position: relative;
    background: #f3f4f6;
    border-top: 1px solid color-mix(in srgb, #000 10%, transparent);
    border-bottom: 1px solid color-mix(in srgb, #000 10%, transparent);
    padding: clamp(34px, 6vw, 76px) 0;
    overflow: hidden;
  }

  .band::before {
    content: "G";
    position: absolute;
    inset: auto 0 50% 0;
    transform: translateY(50%);
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: min(48vw, 560px);
    line-height: 0.85;
    text-align: center;
    color: rgba(0, 0, 0, 0.06);
    pointer-events: none;
    user-select: none;
  }

  .icons {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(5, minmax(150px, 1fr));
    gap: 22px;
    align-items: start;
    justify-items: center;
    width: 100%;
  }

  .icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 170px;
    justify-self: center;
  }


  .icon {
    position: relative;
    width: 84px;
    height: 84px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    border: 4px solid color-mix(in srgb, #000 90%, transparent);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, #000 6%, transparent);
    background: rgba(255, 255, 255, 0.65);
    color: color-mix(in srgb, #000 85%, transparent);
    margin-bottom: 10px;
  }

  .icon svg {
    display: block;
    margin: 0 auto;
  }

  .icon::after {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    pointer-events: none;
  }

  /* Use primary color for SVG strokes as accent */
  .icon svg path,
  .icon svg circle,
  .icon svg rect,
  .icon svg line {
    stroke: color-mix(in srgb, var(--primary) 80%, currentColor);
  }


  .icon-title {
    margin: 0 0 4px;
    font-weight: 600;
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.1;
  }

  .icon-desc {
    margin: 0;
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--text) 70%, transparent);
  }

  .cta {
    position: relative;
    z-index: 1;
    margin-top: clamp(28px, 5vw, 54px);
    text-align: center;
  }

  .quote {
    margin: 0 0 14px;
    font-style: italic;
    font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    color: color-mix(in srgb, var(--text) 85%, transparent);
  }

  @media (max-width: 980px) {
    .icons {
      grid-template-columns: repeat(3, minmax(140px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .icons {
      grid-template-columns: repeat(2, minmax(120px, 1fr));
    }

    .icon-card {
      max-width: none;
    }
  }
</style>
